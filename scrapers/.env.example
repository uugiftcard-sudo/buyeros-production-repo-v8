# ──────────────────────────────────────────────────────────────
# API Keys — Obtain from respective platforms
# ──────────────────────────────────────────────────────────────

# Apollo.io B2B contact search (free tier: 50 lookups/month)
# https://apollo.io
APOLLO_API_KEY=your_apollo_key_here

# Hunter.io email finder (free tier: 25 searches/month)
# https://hunter.io
HUNTER_API_KEY=your_hunter_key_here

# ── Output ─────────────────────────────────────────────────────
OUTPUT_DIR=./output
DEFAULT_FORMAT=csv

# ── Rate Limiting ─────────────────────────────────────────────
DEFAULT_DELAY=2.0
MAX_RETRIES=3

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── HTTP ──────────────────────────────────────────────────────
HTTP_TIMEOUT=15
VERIFY_SSL=true

# ── Proxy (optional) ──────────────────────────────────────────
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# ── FastAPI Server ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_api_key_here

# ── Redis Cache ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json
