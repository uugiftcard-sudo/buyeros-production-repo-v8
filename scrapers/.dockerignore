# ──────────────────────────────────────────────────────────────
# .dockerignore — exclude from Docker build context
# ──────────────────────────────────────────────────────────────

# Git
.git
.gitignore

# Tests
tests/
__pycache__/
.pytest_cache/
.coverage
*.pyc
*.pyo

# Docs
*.md
!README.md

# Env / secrets
.env
.env.*
secrets/
*.key
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/
*.egg-info/
scrapers.egg-info/

# Lint / cache
.ruff_cache/
.mypy_cache/
htmlcov/

# OS
.DS_Store
Thumbs.db

# Output (mounted as volume — no need to copy)
output/
