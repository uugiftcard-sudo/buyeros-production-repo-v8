# BuyerOS production env
# Copy this file to .env.production and fill the values before VPS deploy.

# Required for public deployment
PUBLIC_BASE_URL=https://YOUR_DOMAIN
BUYEROS_DOMAIN=YOUR_DOMAIN
BUYEROS_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
BUYEROS_CORS_ORIGINS=https://YOUR_DOMAIN,http://localhost:3000

# Supabase long-term memory
SUPABASE_URL=
SUPABASE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Redis inside docker compose
REDIS_URL=redis://redis:6379/0

# Provider gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL_SUPERVISOR=openai/gpt-4o-mini
OPENROUTER_MODEL_OPS=openai/gpt-4o-mini
OPENROUTER_MODEL_FINANCE=openai/gpt-4o-mini
OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_CURSOR=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_OPENAI=openai/gpt-4o-mini
OPENROUTER_MODEL_GEMINI=google/gemini-pro-1.5
OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-chat
OPENROUTER_MODEL_MINIMAX=minimax/minimax-01
OPENROUTER_MODEL_GROK=x-ai/grok-2
OPENROUTER_MODEL_PERPLEXITY=perplexity/sonar

# Optional direct provider keys, reserved for future direct adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
GROK_API_KEY=
PERPLEXITY_API_KEY=
HERMES_API_KEY=
OPENCLAW_API_KEY=

# Optional business integrations
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
OCR_SPACE_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image
FINANCE_API_BASE_URL=
FINANCE_API_KEY=
