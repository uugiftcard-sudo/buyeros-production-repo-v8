# BuyerOS environment variables (example)
# Copy to `.env` and fill in real values.
# DO NOT commit `.env`.

# ── Core security ───────────────────────────────────────────────────────────
# Used by `require_api_key` to protect endpoints.
BUYEROS_API_KEY=

# Browser-friendly access for /admin
ADMIN_DASHBOARD_TOKEN=

# ── Supabase (Recon + Bank import) ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── OpenRouter (Receipt Vision OCR) ─────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Telegram (optional) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Redis (optional; docker-compose provides redis service) ─────────────────
REDIS_URL=redis://redis:6379/0

# ── Other optional provider keys (only if you use them) ─────────────────────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# DEEPSEEK_API_KEY=
# GROK_API_KEY=
# MINIMAX_API_KEY=
