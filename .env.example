# Environment variables for BuyerOS — Professional Edition
# Copy to .env (and .env.production for VPS) and fill in values.

# ─── Core ──────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PUBLIC_BASE_URL=https://YOUR_DOMAIN
BUYEROS_DOMAIN=YOUR_DOMAIN
REDIS_URL=redis://redis:6379/0
BUYEROS_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
BUYEROS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BUYEROS_ENV=production               # Enables structured JSON logging (default: production)
# BUYEROS_VERSION=8.0.0               # Shown in Sentry events

# ─── Security: Rate Limiting ───────────────────────────────────────────────────
# BUYEROS_RATE_LIMIT=100/minute,10/second   # Default: 100/min, 10/s burst

# ─── Observability ─────────────────────────────────────────────────────────────
# Sentry (error tracking — get dsn from sentry.io)
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1    # Trace 10% of requests (production)

# ─── Cron / Scheduler ──────────────────────────────────────────────────────────
# BUYEROS_BACKUP_DIR=/opt/buyeros-backups
# BACKUP_RETENTION_DAYS=30          # Remove backups older than N days
# SCHEDULER_ENABLED=true            # Run APScheduler jobs (default: true)

# ─── NextAuth (Frontend Auth) ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_USE_openssl_rand_-hex_32
# NEXTAUTH_USERS=admin,operator     # Comma-separated usernames
# NEXTAUTH_PASSWORD_HASH=changeme   # Plaintext passwords (replace with bcrypt hashes in prod)

# Multi-provider context layer. Providers may be configured gradually.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_SUPERVISOR=openai/gpt-4o-mini
OPENROUTER_MODEL_OPS=openai/gpt-4o-mini
OPENROUTER_MODEL_FINANCE=openai/gpt-4o-mini
OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_CURSOR=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_OPENAI=openai/gpt-4o-mini
OPENROUTER_MODEL_GEMINI=google/gemini-pro-1.5
OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-chat
OPENROUTER_MODEL_MINIMAX=minimax/minimax-01
OPENROUTER_MODEL_GROK=x-ai/grok-2
OPENROUTER_MODEL_PERPLEXITY=perplexity/sonar
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
GROK_API_KEY=
PERPLEXITY_API_KEY=
HERMES_API_KEY=
OPENCLAW_API_KEY=

# ─── Payment Gateways ───────────────────────────────────────────────────────
# Stripe (preferred)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=              # from `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_API_VERSION=2024-04-10

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # or: live

# Custom REST fallback
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=

# ─── Finance / Google Sheets ────────────────────────────────────────────────
GOOGLE_SHEETS_ID=                           # Spreadsheet ID from URL
GOOGLE_SERVICE_ACCOUNT_JSON=                # Full JSON string (service account)
# or
GOOGLE_SHEETS_API_KEY=                     # API key (public sheets only)

# ─── E-Commerce (Orders + Buyers) ───────────────────────────────────────────
# Shopify
SHOPIFY_SHOP_DOMAIN=                       # e.g. yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=                       # Admin API access token

# Custom REST fallback
ORDERS_API_BASE_URL=
ORDERS_API_KEY=
BUYERS_API_BASE_URL=
BUYERS_API_KEY=

# Optional business integrations
OCR_SPACE_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image
FINANCE_API_BASE_URL=
FINANCE_API_KEY=
